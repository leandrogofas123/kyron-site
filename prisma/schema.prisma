// Modelo de dados do catálogo Kyron.
//
// Fiel à seção 5 da spec. É o primeiro módulo do futuro CRM/ERP — por isso o
// modelo de Produto é limpo e reaproveitável por estoque, venda e cliente nas
// fases seguintes.
//
// SQLite agora; trocar para PostgreSQL depois é mudar só o datasource.
//
// Dinheiro é guardado em CENTAVOS (Int), nunca em ponto flutuante — R$ 1.999,90
// vira 199990. Formatação para reais acontece na exibição. Float em dinheiro é
// bug garantido (arredondamento).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Postgres do Railway (serviço "Postgres"). DATABASE_URL aponta para ele.
  // Migrado do SQLite para suportar o ERP (concorrência, relações, busca).
  url      = env("DATABASE_URL")
}

model Categoria {
  id        Int    @id @default(autoincrement())
  slug      String @unique
  nome      String
  icone     String?
  ordem     Int    @default(0)

  // Auto-relação: subcategoria aponta para a categoria pai.
  parentId  Int?
  parent    Categoria?  @relation("Subcategorias", fields: [parentId], references: [id])
  filhas    Categoria[] @relation("Subcategorias")

  produtos  Produto[]

  @@index([parentId])
}

/// Marca comercial (Apple, JBL, Intelbras…). Antes era texto livre em Produto;
/// virou entidade para dar filtro por marca, página de marca e consistência
/// ("Apple" e "apple" deixam de ser marcas diferentes). O texto `marca` de
/// Produto continua existindo como rótulo de exibição/fallback.
model Marca {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  nome      String
  logo      String?
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())
  produtos  Produto[]

  @@index([ativo])
}

model Produto {
  id               Int      @id @default(autoincrement())
  slug             String   @unique
  nome             String
  marca            String?
  marcaId          Int?
  marcaRef         Marca?   @relation(fields: [marcaId], references: [id])
  // Centavos. precoPromo, quando presente, é o preço vigente.
  preco            Int
  precoPromo       Int?
  descricaoCurta   String?
  descricaoLonga   String?

  // ─── Campos do ERP (fonte única de verdade: loja + estoque) ───
  codigoInterno    String?  @unique
  sku              String?  @unique
  ean              String?  // código de barras
  ncm              String?
  modelo           String?
  cor              String?
  capacidade       String?
  voltagem         String?
  precoCusto       Int?     // centavos
  precoMinimo      Int?     // centavos
  quantidade       Int      @default(0)   // saldo atual (mantido por transação)
  quantidadeMinima Int      @default(0)   // alerta de estoque baixo
  localizacao      String?  // prateleira/gaveta
  garantiaMeses    Int?
  observacoes      String?
  excluidoEm       DateTime?               // exclusão lógica: nunca apagar

  fornecedorId     Int?
  fornecedor       Fornecedor? @relation(fields: [fornecedorId], references: [id])

  movimentacoes    MovimentacaoEstoque[]
  itensNota        NotaItem[]
  // Modelos compatíveis, separados por vírgula. Ex.: "iPhone 15, iPhone 14".
  // "Universal" mantém acessórios que funcionam com qualquer celular visíveis
  // no configurador Monte seu Kit Celular.
  compatibilidade  String?
  destaque         Boolean  @default(false)  // aparece na home
  ativo            Boolean  @default(true)    // inativo some do site, fica no banco
  ordem            Int      @default(0)
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt

  categoriaId      Int
  categoria        Categoria @relation(fields: [categoriaId], references: [id])

  imagens          ProdutoImagem[]
  seminovo         Seminovo?

  @@index([categoriaId])
  @@index([ativo, destaque])
  @@index([ean])
  @@index([fornecedorId])
  @@index([excluidoEm])
  @@index([nome])
  @@index([marcaId])
}

model ProdutoImagem {
  id         Int     @id @default(autoincrement())
  url        String
  principal  Boolean @default(false)
  ordem      Int     @default(0)

  produtoId  Int
  produto    Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId])
}

// Estende Produto (1:1). Os campos são exatamente as objeções de quem compra
// iPhone usado — publicá-los permite vender acima do preço de marketplace.
model Seminovo {
  produtoId        Int     @id
  produto          Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  saudeBateria     Int?    // %
  condicaoEstetica String  @default("bom") // impecável | ótimo | bom (validado no app)
  cor              String?
  capacidade       String?
  garantiaMeses    Int     @default(0)
  vendido          Boolean @default(false) // some da vitrine automaticamente

  @@index([vendido])
}

model Servico {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  nome            String
  descricao       String?
  precoAPartirDe  Int?     // centavos; null = "sob orçamento"
  atendeEmDomicilio Boolean @default(false)
  tempoMedio      String?
  imagemCapa      String?
  ativo           Boolean  @default(true)
  ordem           Int      @default(0)
}

// ────────────────────────── CORE ───────────────────────────

/// Trilha de auditoria de TODA a plataforma (módulo core).
/// Responde "quem fez o quê, quando e a partir de onde" — inclusive para o que
/// o ledger de estoque não cobre: preço alterado, acesso concedido, cliente
/// aprovado, login. Nomes em português para casar com o resto do schema.
model AuditLog {
  id          Int      @id @default(autoincrement())
  criadoEm    DateTime @default(now())

  // Quem: admin | colaborador | usuario | sistema
  atorTipo    String   @default("sistema")
  atorId      Int?
  atorNome    String?

  modulo      String   // erp | admin | loja | auth
  acao        String   // criar | atualizar | excluir | aprovar | login | ...
  entidade    String?  // Produto, Colaborador, ClienteErp…
  entidadeId  String?

  valorAntes  String?  // JSON serializado (só os campos que mudaram)
  valorDepois String?

  ip          String?
  userAgent   String?
  metadata    String?  // JSON livre

  @@index([criadoEm])
  @@index([modulo, acao])
  @@index([entidade, entidadeId])
  @@index([atorTipo, atorId])
}

// ─────────────────────────── ERP ───────────────────────────

model Fornecedor {
  id          Int      @id @default(autoincrement())
  nome        String
  cnpj        String?  @unique
  contato     String?
  telefone    String?
  email       String?
  cidade      String?
  estado      String?
  observacoes String?
  excluidoEm  DateTime?
  criadoEm    DateTime @default(now())

  produtos    Produto[]
  notas       NotaFiscal[]

  @@index([nome])
}

/// Quem opera o ERP. Papel define as permissões (RBAC).
model Colaborador {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String
  papel     String   @default("vendedor") // admin | gerente | vendedor | tecnico
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  movimentacoes MovimentacaoEstoque[]

  @@index([papel])
}

/// Ledger imutável: toda alteração de saldo passa por aqui.
model MovimentacaoEstoque {
  id            Int      @id @default(autoincrement())
  // entrada | saida | ajuste | transferencia | venda | troca | assistencia |
  // devolucao | perda
  tipo          String
  quantidade    Int      // positivo; o tipo define o sinal
  saldoAntes    Int
  saldoDepois   Int
  motivo        String?
  documento     String?  // nº da NF, OS, pedido…
  observacao    String?
  criadoEm      DateTime @default(now())

  produtoId     Int
  produto       Produto  @relation(fields: [produtoId], references: [id])
  // colaboradorId: legado do auth antigo. Mantido durante a migração para o
  // código no ar não quebrar; removido depois que tudo usar usuarioId.
  colaboradorId Int?
  colaborador   Colaborador? @relation(fields: [colaboradorId], references: [id])
  usuarioId     Int?
  usuario       Usuario?     @relation(fields: [usuarioId], references: [id])
  notaId        Int?
  nota          NotaFiscal?  @relation(fields: [notaId], references: [id])
  // Venda/troca/assistência podem ser atribuídas a um cliente — é o que
  // alimenta o histórico e o controle de garantia por pessoa.
  clienteId     Int?
  cliente       ClienteErp?  @relation(fields: [clienteId], references: [id])

  @@index([produtoId, criadoEm])
  @@index([tipo])
  @@index([notaId])
  @@index([clienteId])
}

/// Nota fiscal de entrada (XML da NF-e importado).
model NotaFiscal {
  id           Int      @id @default(autoincrement())
  chave        String?  @unique
  numero       String?
  serie        String?
  emitidaEm    DateTime?
  valorTotal   Int?     // centavos
  xml          String?  // XML bruto, para auditoria
  status       String   @default("importada") // importada | conferida | finalizada
  criadoEm     DateTime @default(now())

  fornecedorId Int?
  fornecedor   Fornecedor? @relation(fields: [fornecedorId], references: [id])

  itens        NotaItem[]
  movimentacoes MovimentacaoEstoque[]

  @@index([status])
  @@index([fornecedorId])
}

/// Item da nota: fica com a descrição original até ser vinculado a um Produto.
model NotaItem {
  id           Int      @id @default(autoincrement())
  descricao    String
  ean          String?
  ncm          String?
  cfop         String?
  quantidade   Int
  valorUnitario Int     // centavos
  acao         String   @default("pendente") // pendente | criar | vincular
  processado   Boolean  @default(false)

  notaId       Int
  nota         NotaFiscal @relation(fields: [notaId], references: [id], onDelete: Cascade)
  produtoId    Int?
  produto      Produto?   @relation(fields: [produtoId], references: [id])

  @@index([notaId])
  @@index([ean])
}

/// Cliente do ERP (histórico de compras e assistência).
model ClienteErp {
  id          Int      @id @default(autoincrement())
  nome        String
  telefone    String?
  email       String?
  cpf         String?
  cidade      String?
  observacoes String?
  excluidoEm  DateTime?
  criadoEm    DateTime @default(now())

  movimentacoes MovimentacaoEstoque[]

  @@index([nome])
  @@index([telefone])
}

/// Usuário ÚNICO da plataforma (módulo auth).
/// Substitui os três sistemas antigos: admin da loja (env), cliente das aulas e
/// colaborador do ERP. Um login, um cookie, papéis definindo o que cada um vê.
model Usuario {
  id              Int      @id @default(autoincrement())
  nome            String
  email           String   @unique
  senhaHash       String                    // scrypt (salt:hash), nunca a senha crua
  telefone        String?
  avatar          String?
  ativo           Boolean  @default(true)
  emailVerificado Boolean  @default(false)
  /// Clientes das aulas nascem pendentes; o admin aprova.
  aprovado        Boolean  @default(false)
  ultimoLogin     DateTime?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  papeis          UsuarioPapel[]
  sessoes         Sessao[]
  movimentacoes   MovimentacaoEstoque[]
  tokens          TokenAcesso[]

  @@index([aprovado])
  @@index([ativo])
}

/// Papel (role). A hierarquia usa `nivel`: menor = mais poder.
model Papel {
  id       Int    @id @default(autoincrement())
  chave    String @unique // ADMIN_MASTER, ADMIN, GERENTE, VENDEDOR, TECNICO, FINANCEIRO, CLIENTE, SUPORTE
  nome     String
  nivel    Int    @default(100)
  usuarios UsuarioPapel[]
}

model UsuarioPapel {
  usuarioId Int
  papelId   Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  papel     Papel   @relation(fields: [papelId], references: [id], onDelete: Cascade)

  @@id([usuarioId, papelId])
  @@index([papelId])
}

/// Sessão no servidor — permite REVOGAR acesso na hora (o modelo antigo, só
/// com cookie assinado, não permitia: valia até expirar).
model Sessao {
  id         String    @id @default(uuid())
  usuarioId  Int
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  /// Guarda o HASH do token, nunca o token — vazamento do banco não vira sessão.
  tokenHash  String    @unique
  dispositivo String?
  navegador  String?
  ip         String?
  expiraEm   DateTime
  revogadaEm DateTime?
  criadoEm   DateTime  @default(now())

  @@index([usuarioId])
  @@index([expiraEm])
}

/// Token de uso único: recuperação de senha e convite de acesso.
model TokenAcesso {
  id        String   @id @default(uuid())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  tipo      String   // recuperar-senha | convite
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime @default(now())

  @@index([usuarioId, tipo])
}

// Conteúdo do Manual de Instalação. Um modelo cobre os dois casos:
//  - Post público (novidades/informações): restrito=false, sem vídeo.
//  - Aula em vídeo: youtubeId preenchido; restrito=true exige login aprovado.
model Post {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  titulo       String
  resumo       String?
  conteudo     String?                    // texto (novidades/instruções)
  youtubeId    String?                    // preenchido = é uma AULA em vídeo
  restrito     Boolean  @default(false)   // true = só clientes aprovados
  publicado    Boolean  @default(true)
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([publicado])
}

model Lead {
  id           Int      @id @default(autoincrement())
  nome         String
  telefone     String?
  email        String?
  origem       String   @default("geral") // produto | servico | geral | chat
  referenciaId Int?     // id do produto ou serviço de origem
  interesse    String?  // categoria da loja (quando veio do chat)
  urgencia     String?
  perfil       String?
  mensagem     String?
  transcricao  String?  // conversa do chat, quando houver
  status       String   @default("novo")  // novo | respondido | vendido | perdido
  criadoEm     DateTime @default(now())

  @@index([status])
  @@index([criadoEm])
}
