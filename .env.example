# === BANCO E ARQUIVOS (importante em produção) ===
# Caminho do banco SQLite. Local: file:./kyron.db (fica em prisma/).
# No Railway: file:/data/kyron.db (disco persistente montado em /data).
DATABASE_URL=file:./kyron.db

# Onde as fotos dos produtos são gravadas. Local: em falta, usa ./data/uploads.
# No Railway: /data/uploads (mesmo disco persistente do banco).
UPLOADS_DIR=

# === CHAVES ===
# Chave da API da Anthropic — obrigatória.
# Crie em https://platform.claude.com  →  Settings  →  API Keys
ANTHROPIC_API_KEY=

# HubSpot — SUSPENSO. O CRM agora é interno (aba Leads / Kanban no painel).
# Mantido só por compatibilidade; pode deixar vazio.
HUBSPOT_TOKEN=

# Notificação por e-mail a cada novo lead e novo cliente (via Resend).
# RESEND_API_KEY: crie em https://resend.com (permissão "Sending access").
# Sem ela, o aviso só é registrado no log — nada se perde, mas ninguém é avisado.
#
# ATENÇÃO: sem domínio verificado, o Resend usa o remetente de teste
# (onboarding@resend.dev) e só ENTREGA para o e-mail dono da conta. Portanto
# NOTIFY_EMAIL precisa ser esse mesmo e-mail. Depois de verificar
# kyroncompany.com no Resend, defina EMAIL_FROM e envie para qualquer endereço.
RESEND_API_KEY=
NOTIFY_EMAIL=
EMAIL_FROM=

# Destino alternativo, caso não use HubSpot: webhook de n8n, Zapier, Make etc.
# Só é usado se HUBSPOT_TOKEN estiver vazio.
KYRON_LEAD_WEBHOOK_URL=

# Número do WhatsApp comercial, apenas dígitos, com DDI e DDD.
# Ex.: 5511987654321
NEXT_PUBLIC_KYRON_WHATSAPP=

# URL da página de agendamento do diagnóstico (Cal.com).
NEXT_PUBLIC_KYRON_AGENDA_URL=

# Google Analytics 4 — formato G-XXXXXXXXXX.
# Sem esta variável o site não carrega nenhum script de medição.
# Mesmo com ela, o script só entra na página APÓS o aceite no banner de cookies.
NEXT_PUBLIC_GA_ID=

# Domínio público do site. Usado no sitemap, canonical e dados estruturados.
NEXT_PUBLIC_SITE_URL=https://kyroncompany.com

# Painel admin (/admin). Sem estas duas, o painel fica desativado.
# ADMIN_SECRET: gere com  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SECRET=
